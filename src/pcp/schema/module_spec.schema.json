{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pcp-protocol.com/schema/module_spec.schema.json",
  "title": "PCP Module Spec",
  "type": "object",
  "required": ["module", "description"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string"
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "objective_coverage": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deprecated": {
      "type": "boolean"
    }
  }
}
