{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pcp-protocol.com/schema/ci_rules.schema.json",
  "title": "PCP CI Rules",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "check", "severity"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+$" },
          "name": { "type": "string" },
          "check": {
            "type": "string",
            "enum": ["ast_pattern", "llm_semantic"]
          },
          "pattern": { "type": "string" },
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["hard_block", "advisory"]
          },
          "scope": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "if": {
          "properties": { "check": { "const": "ast_pattern" } }
        },
        "then": {
          "required": ["pattern"]
        },
        "else": {
          "required": ["description"]
        }
      }
    }
  }
}
