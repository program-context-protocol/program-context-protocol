{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pcp-protocol.com/schema/traceability_map.schema.json",
  "title": "PCP Traceability Map",
  "type": "object",
  "required": ["generated_at", "links"],
  "additionalProperties": false,
  "properties": {
    "generated_at": { "type": "string" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "feature_id", "feature_description", "module", "confidence_score", "review_status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "feature_id": { "type": "string" },
          "feature_description": { "type": "string" },
          "module": { "type": "string" },
          "confidence_score": { "type": "number" },
          "rationale": { "type": ["string", "null"] },
          "review_status": { "type": "string", "enum": ["red", "blue", "green"] }
        }
      }
    }
  }
}
